{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "iran-crisis-map",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "require('http').createServer((q,r)=>{const fs=require('fs'),p=require('path');let f=p.join('.',q.url==='/'?'index.html':q.url);fs.readFile(f,(e,d)=>{if(e){r.writeHead(404);r.end('Not found');}else{r.writeHead(200,{'Content-Type':'text/html'});r.end(d);}});}).listen(3000,()=>console.log('Serving on 3000'))"],
      "port": 3000
    }
  ]
}
